  },
  "policy_set": {
    "version": "v1.0.0",
    "description": "Highest-priority rule is staged — it would have BLOCKed but does not bind. A lower-priority ACTIVE rule binds an ALLOW. This is the side-by-side evaluation invariant: staged rules don't block active rules from firing.",
    "scope": {
